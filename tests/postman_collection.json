{
  "info": {
    "name": "Chatbot Escuela Técnica - PSR TP03-C2",
    "description": "Colección para demostrar el funcionamiento de la API REST del chatbot escolar. Importable en Postman e Insomnia. Requiere que app.py esté corriendo en http://localhost:5000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "00 - Health check (GET /health)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Verifica que el servidor esté publicado y el modelo cargado."
      }
    },
    {
      "name": "01 - Info de la API (GET /)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "02 - RF-02 Constancia de alumno regular",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"message\": \"¿Cómo saco la constancia de alumno regular?\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/chat",
          "host": ["{{base_url}}"],
          "path": ["chat"]
        }
      }
    },
